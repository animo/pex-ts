{
  "name": "pex-root",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/animo/pex-ts"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48",
  "scripts": {
    "build": "pnpm -r build",
    "types:check": "pnpm -r types:check",
    "style:check": "biome check --unsafe",
    "style:fix": "biome check --write --unsafe",
    "packages:check": "node scripts/check-package-entrypoints.mjs",
    "esm:check": "node scripts/check-package-esm-imports.mjs",
    "ci:check": "pnpm style:check && pnpm types:check && pnpm test",
    "test": "vitest",
    "release": "pnpm packages:check && pnpm types:check && pnpm build && pnpm esm:check && pnpm changeset publish --no-git-tag",
    "changeset-version": "pnpm changeset version && pnpm style:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "vitest": "^5.0.5"
  }
}
