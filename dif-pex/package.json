{
  "name": "@animo-id/dif-pex",
  "version": "0.1.0",
  "description": "A lean TypeScript implementation of the DIF Presentation Exchange v1 and v2 specification",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "publishConfig": {
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean --sourcemap",
    "types:check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "keywords": [
    "Presentation Exchange",
    "DIF Presentation Exchange",
    "PEX",
    "Verifiable Presentations",
    "Verifiable Credentials",
    "Selective Disclosure",
    "OpenID4VP",
    "OID4VP",
    "SSI",
    "DIF"
  ]
}
